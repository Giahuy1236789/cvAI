PORT=5000
JWT_SECRET=your_super_secret_jwt_key_here_change_this
JWT_EXPIRE=7d
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# Deadline for the entire response, between 5000 and 60000 ms.
GEMINI_TIMEOUT_MS=60000
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ai_cv_job_db
DB_USER=root
DB_PASSWORD=your_mysql_password
# Jobicy sync runs once every 6 hours by default. Use the mock source for offline testing.
JOB_SYNC_ENABLED=true
JOB_SYNC_INTERVAL_HOURS=6
# JOBICY_MOCK=true
